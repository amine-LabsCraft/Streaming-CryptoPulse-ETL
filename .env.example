# ============================================================
# CryptoPulse ETL - Example Environment Configuration
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=CryptoPulse ETL
APP_ENV=development
APP_VERSION=1.0.0
APP_DEBUG=true
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Binance Spot WebSocket
#
# Keep only the base endpoint here.
# Do not add /ws or /stream?streams=.
# ------------------------------------------------------------

BINANCE_WS_URL=wss://stream.binance.com:9443

# Comma-separated lowercase symbols
BINANCE_SYMBOLS=btcusdt,ethusdt

# Supported values: trade, aggtrade
BINANCE_STREAM_NAME=trade

BINANCE_CONNECT_TIMEOUT_SECONDS=15
BINANCE_CALLBACK_TIMEOUT_SECONDS=10

BINANCE_RECONNECT_INITIAL_DELAY_SECONDS=1
BINANCE_RECONNECT_MAX_DELAY_SECONDS=60

# Debug-only bounded in-memory buffer
BINANCE_MAX_BUFFER_SIZE=100

BINANCE_MAX_MESSAGE_SIZE_BYTES=1048576


# ------------------------------------------------------------
# MySQL
# ------------------------------------------------------------

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=cryptopulse_app

# Replace locally. Never commit the real value.
MYSQL_PASSWORD=change_me

MYSQL_DATABASE=cryptopulse

MYSQL_CONNECT_TIMEOUT=10
MYSQL_READ_TIMEOUT=30
MYSQL_WRITE_TIMEOUT=30


# ------------------------------------------------------------
# MongoDB
# ------------------------------------------------------------

MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=cryptopulse

MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_CONNECT_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000

MONGO_MAX_POOL_SIZE=20
MONGO_MIN_POOL_SIZE=0
MONGO_RETRY_WRITES=true

# Optional raw samples expire after 24 hours
RAW_SAMPLE_TTL_SECONDS=86400


# ------------------------------------------------------------
# Minute aggregation
# ------------------------------------------------------------

MINUTE_INTERVAL_SECONDS=60

# Accept trades arriving up to 5 seconds after minute closure
ALLOWED_LATENESS_SECONDS=5

# Bounded debug and health history
SNAPSHOT_HISTORY_SIZE=1000

DEDUPLICATE_TRADES=true

# Recommended false for stable Power BI data
STORE_PARTIAL_SNAPSHOTS=false


# ------------------------------------------------------------
# Event detection
# ------------------------------------------------------------

PRICE_SPIKE_THRESHOLD_PCT=0.5
HIGH_VOLUME_MULTIPLIER=2.0
HIGH_VOLATILITY_THRESHOLD_PCT=5.0

VOLUME_WINDOW_SIZE=20
MINIMUM_VOLUME_HISTORY=5


# ------------------------------------------------------------
# Async queues and workers
# ------------------------------------------------------------

SNAPSHOT_QUEUE_SIZE=500
EVENT_QUEUE_SIZE=500

SNAPSHOT_FLUSH_INTERVAL_SECONDS=1
STORAGE_CHECK_INTERVAL_SECONDS=60


# ------------------------------------------------------------
# Storage and retention
#
# Required relationship:
# warning < critical < limit
# ------------------------------------------------------------

STORAGE_WARNING_MB=800
STORAGE_CRITICAL_MB=950
STORAGE_LIMIT_MB=1000

RETENTION_DAYS=30


# ------------------------------------------------------------
# Power BI
# ------------------------------------------------------------

POWER_BI_MYSQL_TABLE=fact_market_minute
POWER_BI_REFRESH_INTERVAL_MINUTES=1